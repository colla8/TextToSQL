# Copy to .env and fill in real values. .env is git-ignored -- never commit it.

# Telegram bot token from @BotFather
TOKEN=

# PostgreSQL (store data)
PG_HOST=localhost
PG_PORT=5432
PG_DATABASE=online_store
PG_USER=textsql
PG_PASSWORD=change-me

# Ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b

# Optional: local embedding model dir. If the path doesn't exist the model
# (EMBEDDING_MODEL_NAME, default BAAI/bge-m3) is downloaded from HuggingFace.
# EMBEDDING_MODEL_PATH=models/embeddings/bge-m3

# Schema retrieval: lexical (BM25+fuzzy) first, embedding+FAISS only as a
# fallback when the lexical top score is below this threshold (0..1).
# LEXICAL_CONFIDENCE_THRESHOLD=0.35

# Query cache (SQL / retrieval / result)
# CACHE_ENABLED=true

# API
# API_PORT=8000
# CORS_ORIGINS=*
# LOG_LEVEL=INFO
